// /etc/alloy/config.alloy
// Unified log aggregation for PANOSETI components.
// Reads per-host .jsonl files written by panoseti_grpc get_logger().
// Directory layout: /var/log/panoseti/{hostname}/{service}.jsonl

local.file_match "panoseti" {
  path_targets = [{ "__path__" = "/var/log/panoseti/*/*.jsonl", "job" = "panoseti" }]
}

loki.source.file "panoseti" {
  targets    = local.file_match.panoseti.targets
  forward_to = [loki.process.panoseti.receiver]
}

loki.process "panoseti" {
  stage.json {
    expressions = {
      message    = "message",
      service    = "service",
      level      = "level",
      hostname   = "hostname",
      git_commit = "git_commit",
      run_id     = "run_id",
    }
  }
  stage.labels {
    values = {
      service    = "service",
      level      = "level",
      hostname   = "hostname",
      git_commit = "git_commit",
    }
  }
  forward_to = [loki.write.headnode.receiver]
}

loki.write "headnode" {
  // Alloy runs with network_mode: host, so the bridge-network DNS name "loki"
  // does not resolve here (and Loki lives on the headnode, not this DAQ node).
  // Point at the headnode's IP instead.
  endpoint { url = string.format("http://%s:3100/loki/api/v1/push", sys.env("HEADNODE_IP")) }
  external_labels = { cluster = "panoseti" }
}
